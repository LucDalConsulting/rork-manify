# Manify build & release automation (Rork-free).
# Authenticates to Apple with an App Store Connect API key (.p8) and uses
# Xcode automatic "cloud" signing (-allowProvisioningUpdates), so no manual
# certificates or provisioning profiles are needed.
#
# Required environment variables (set as GitHub Actions secrets):
#   ASC_KEY_ID                App Store Connect API Key ID
#   ASC_ISSUER_ID             App Store Connect Issuer ID
#   ASC_KEY_P8                Contents of the AuthKey_XXXX.p8 file
#   APPLE_TEAM_ID             Apple Developer Team ID (10 chars)
#   REVENUECAT_IOS_API_KEY    RevenueCat public iOS SDK key (for in-app purchases)
#   BUILD_NUMBER              Unique, increasing build number (CI run number)

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
    is_key_content_base64: ENV["ASC_KEY_P8_BASE64"] == "true",
    in_house: false
  )
end

def shared_xcargs
  rc = ENV["REVENUECAT_IOS_API_KEY"].to_s
  build = ENV["BUILD_NUMBER"].to_s
  build = "1" if build.empty?
  team = ENV["APPLE_TEAM_ID"].to_s
  [
    "DEVELOPMENT_TEAM=\"#{team}\"",
    "CURRENT_PROJECT_VERSION=#{build}",
    "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=\"#{rc}\"",
    "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=\"#{rc}\"",
    "-allowProvisioningUpdates"
  ].join(" ")
end

def build_ipa(api_key)
  build_app(
    project: "Manify.xcodeproj",
    scheme: "Manify",
    configuration: "Release",
    export_method: "app-store",
    api_key: api_key,
    xcargs: shared_xcargs,
    export_options: { signingStyle: "automatic" },
    output_directory: "build",
    output_name: "Manify.ipa",
    clean: true
  )
end

platform :ios do
  desc "Build and upload a new build to TestFlight (lands on your test phone)"
  lane :beta do
    key = asc_api_key
    build_ipa(key)
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      distribute_external: false
    )
  end

  desc "Build and upload to the App Store (still requires you to submit for review in App Store Connect)"
  lane :release do
    key = asc_api_key
    build_ipa(key)
    upload_to_app_store(
      api_key: key,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false
    )
  end
end
