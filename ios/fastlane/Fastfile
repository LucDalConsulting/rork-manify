# Manify build & release automation (Rork-free).
# Authenticates to Apple with an App Store Connect API key (.p8) and uses
# Xcode automatic "cloud" signing (-allowProvisioningUpdates), so no manual
# certificates or provisioning profiles are needed.
#
# Required environment variables (set as GitHub Actions secrets):
#   ASC_KEY_ID                App Store Connect API Key ID
#   ASC_ISSUER_ID             App Store Connect Issuer ID
#   ASC_KEY_P8                Contents of the AuthKey_XXXX.p8 file
#   APPLE_TEAM_ID             Apple Developer Team ID (10 chars)
#   REVENUECAT_IOS_API_KEY    RevenueCat public iOS SDK key (for in-app purchases)
#   BUILD_NUMBER              Unique, increasing build number (CI run number)

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_content: ENV["ASC_KEY_P8"],
    is_key_content_base64: ENV["ASC_KEY_P8_BASE64"] == "true",
    in_house: false
  )
end

def shared_xcargs
  rc = ENV["REVENUECAT_IOS_API_KEY"].to_s
  # Offset the CI run number so build numbers always stay above the legacy
  # Rork builds (highest was 11). Done here in Ruby because GitHub Actions
  # YAML expressions don't support arithmetic.
  n = ENV["BUILD_NUMBER"].to_i
  n = 1 if n <= 0
  build = (n + 100).to_s
  team = ENV["APPLE_TEAM_ID"].to_s
  [
    "DEVELOPMENT_TEAM=\"#{team}\"",
    "CURRENT_PROJECT_VERSION=#{build}",
    "EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=\"#{rc}\"",
    "EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=\"#{rc}\"",
    "-allowProvisioningUpdates"
  ].join(" ")
end

def write_api_key_file
  require "tmpdir"
  path = File.join(Dir.tmpdir, "AuthKey_#{ENV['ASC_KEY_ID']}.p8")
  File.write(path, ENV["ASC_KEY_P8"].to_s)
  path
end

def build_ipa
  # build_app/gym has no api_key option, so we hand the App Store Connect API key
  # to xcodebuild via xcargs. Combined with -allowProvisioningUpdates, this lets CI
  # create/refresh the distribution certificate and provisioning profile automatically.
  key_path = write_api_key_file
  auth = "-authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
  build_app(
    project: "Manify.xcodeproj",
    scheme: "Manify",
    configuration: "Release",
    export_method: "app-store",
    xcargs: "#{shared_xcargs} #{auth}",
    export_options: { signingStyle: "automatic" },
    output_directory: "build",
    output_name: "Manify.ipa",
    clean: true
  )
end

platform :ios do
  desc "Build and upload a new build to TestFlight (lands on your test phone)"
  lane :beta do
    key = asc_api_key
    build_ipa
    # Wait for Apple to finish processing so we can auto-expire the previous
    # builds (the "skip waiting" shortcut also skips expiring/distribution).
    # This retires old builds automatically so a stale build never lingers in a
    # test group, and makes the new build available to internal testers.
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: false,
      distribute_external: false,
      expire_previous_builds: true
    )
  end

  desc "Build and upload to the App Store (still requires you to submit for review in App Store Connect)"
  lane :release do
    key = asc_api_key
    build_ipa
    upload_to_app_store(
      api_key: key,
      precheck_include_in_app_purchases: false,
      submit_for_review: false,
      automatic_release: false,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false
    )
  end
end
